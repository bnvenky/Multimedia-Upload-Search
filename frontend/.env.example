# Base URL of the API. Keep "/api/v1" in development (Vite proxies it to the backend)
# or when the backend serves this app. For a separate deployment use the full URL,
# e.g. https://multimedia-search-api.onrender.com/api/v1
VITE_API_URL=/api/v1

# Socket.IO server origin. Leave empty to use the same origin as the page.
VITE_SOCKET_URL=

# Backend address used by the Vite dev proxy (development only)
VITE_DEV_API_TARGET=http://localhost:5000
