# ---------- Server ----------
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
# Number of reverse proxies in front of the app (e.g. 1 on Render/Railway) so req.ip is the real client IP
TRUST_PROXY=0

# ---------- MongoDB Atlas ----------
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/?appName=Multimedia-Upload-Search
MONGODB_DB_NAME=multimedia_search

# ---------- Cloudinary ----------
# Dashboard -> Settings -> API Keys. The key needs upload ("create") permission.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=multimedia-search

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# ---------- Browser / CORS ----------
# Comma-separated list of allowed frontend origins
CLIENT_ORIGINS=http://localhost:5173
# Use "none" (requires HTTPS) when the frontend and API are on different sites
COOKIE_SAME_SITE=lax
# COOKIE_SECURE=true

# ---------- Uploads ----------
MAX_UPLOAD_MB=100

# ---------- Single-service deployment (API also serves the built React app) ----------
SERVE_CLIENT=false
CLIENT_DIST_PATH=../frontend/dist
